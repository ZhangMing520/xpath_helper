{
  "manifest_version": 3,
  "name": "XPath Helper",
  "version": "2.0.0",
  "description": "Extract, edit, and evaluate XPath queries with ease.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle XPath bar",
    "default_icon": {
      "32": "static/icon32.png",
      "48": "static/icon48.png"
    }
  },
  "commands": {
    "toggle-bar": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Show or hide the XPath bar"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "32": "static/icon32.png",
    "48": "static/icon48.png",
    "128": "static/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["bar.css", "bar.html", "bar.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
